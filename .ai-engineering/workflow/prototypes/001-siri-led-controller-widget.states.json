      "regions": ["small-widget"],
      "interactions": [
        "Tap power toggle → toggles device state, logs intent execution",
        "Tap device card → opens control screen (simulated)"
      ]
    },
    {
      "name": "filled-2",
      "description": "Medium widget with 2 devices (Bedroom Strip on, Desk Lamp off) - grid layout with color/intensity preview",
      "urlParam": "?state=filled-2",
      "regions": ["medium-widget", "devices-grid-2"],
      "interactions": [
        "Tap power toggle on any device → toggles that device",
        "Tap device card → opens control screen for that device"
      ]
    },
    {
      "name": "filled-3",
      "description": "Medium widget with 3 devices (Bedroom Strip, Desk Lamp, Living Room) - 3-column grid",
      "urlParam": "?state=filled-3",
      "regions": ["medium-widget-3", "devices-grid-3"],
      "interactions": [
        "Tap power toggle on any device → toggles that device",
        "Tap device card → opens control screen for that device"
      ]
    },
    {
      "name": "filled-large",
      "description": "Large widget with 5 devices - list layout with name, color temp, intensity, schedule, and switch toggle",
      "urlParam": "?state=filled-large",
      "regions": ["large-widget", "devices-list"],
      "interactions": [
        "Tap power toggle switch → toggles device",
        "Tap device row → opens control screen"
      ]
    },
    {
      "name": "empty",
      "description": "Empty state for all three widget sizes - 'No Devices Paired' with Open App button",
      "urlParam": "?state=empty",
      "regions": ["small-widget-empty", "medium-widget-empty", "large-widget-empty"],
      "interactions": [
        "Tap 'Open App' button → launches main app (simulated)"
      ]
    },
    {
      "name": "loading",
      "description": "Loading state with spinner - shown while fetching device data",
      "urlParam": "?state=loading",
      "regions": ["small-widget-loading"],
      "interactions": []
    },
    {
      "name": "error",
      "description": "Error state - 'Unable to Load' with Retry button",
      "urlParam": "?state=error",
      "regions": ["small-widget-error"],
      "interactions": [
        "Tap 'Retry' button → shows loading then returns to filled state"
      ]
    }
